// Разбор дефектного акта на списание ОС из файла XLS/XLSX
// (файл вида "Дефектный акт 1 списание ОС ... .xls").
//
// Особенность файла: таблица растянута на ~160 колонок, одно и то же значение
// продублировано в десятках соседних ячеек (наименование - в колонках C..AS,
// инв. номер - в AY..BM, дата - в BO..CG), при этом реальные колонки данных
// не совпадают с колонками шапки ("ИНВ №" стоит в BG, а номер начинается с AY).
// Поэтому номера колонок не зашиты жестко:
//   1. ищется строка шапки (ячейки "Наименование ОС" и "ИНВ №");
//   2. в каждой строке данных непустые ячейки правее "п/п" группируются в блоки
//      подряд идущих ячеек. Первый блок - наименование ОС, второй - инвентарный номер.
//   3. если блоки по какой-то причине слиплись, значения берутся строго по колонкам шапки.
//
// Точка входа: ПрочитатьДефектныйАкт(ИмяФайла) -> ТаблицаЗначений.
// Код размещать в общем серверном модуле (или модуле обработки). Файл должен быть
// доступен на той стороне, где выполняется код (на сервере - через временное хранилище).

#Область ПрограммныйИнтерфейс

// Читает дефектный акт и возвращает список ОС из него.
//
// Параметры:
//   ИмяФайла - Строка - полный путь к файлу XLS/XLSX.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//     * НомерПП          - Число  - порядковый номер строки в акте (колонка "п/п").
//     * Наименование     - Строка - наименование ОС.
//     * ИнвентарныйНомер - Строка - инвентарный номер как в файле (без пробелов).
//     * НомерСтрокиФайла - Число  - номер строки в файле (для диагностики).
//
Функция ПрочитатьДефектныйАкт(Знач ИмяФайла) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерПП",          Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Наименование",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НомерСтрокиФайла", Новый ОписаниеТипов("Число"));

	ТабДок = ПрочитатьФайлВТабличныйДокумент(ИмяФайла);

	ВысотаТаблицы = ТабДок.ВысотаТаблицы;
	ШиринаТаблицы = ТабДок.ШиринаТаблицы;

	Шапка = НайтиШапкуТаблицы(ТабДок, ВысотаТаблицы, ШиринаТаблицы);
	Если Шапка = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"В файле ""%1"" не найдена шапка таблицы (ячейки ""Наименование ОС"" и ""ИНВ №"").",
			ИмяФайла);
	КонецЕсли;

	// Правее "Причина списания" ничего полезного нет - не читаем лишние ячейки.
	ПраваяГраница = ?(Шапка.КолонкаПричина = 0, ШиринаТаблицы, Шапка.КолонкаПричина - 1);

	ДанныеНачались = Ложь;

	Для НомерСтроки = Шапка.НомерСтроки + 1 По ВысотаТаблицы Цикл

		ТекстПП = ТекстЯчейки(ТабДок, НомерСтроки, Шапка.КолонкаПП);
		Если ПустаяСтрока(ТекстПП) Тогда
			Продолжить;
		КонецЕсли;

		НомерПП = ЧислоИзСтроки(ТекстПП);
		Если НомерПП = Неопределено Тогда
			// Нечисловой текст в колонке "п/п" после начала данных - это подвал акта
			// ("Перечисленные ОС подлежат списанию...", подписи комиссии). Таблица закончилась.
			Если ДанныеНачались Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ДанныеНачались = Истина;

		Блоки = БлокиЗначенийСтроки(ТабДок, НомерСтроки, Шапка.КолонкаПП + 1, ПраваяГраница);

		Наименование     = "";
		ИнвентарныйНомер = "";

		ИнвВПервомБлоке = Блоки.Количество() > 0
			И Шапка.КолонкаИнв >= Блоки[0].НачальнаяКолонка
			И Шапка.КолонкаИнв <= Блоки[0].КонечнаяКолонка;

		Если Блоки.Количество() >= 2 И Не ИнвВПервомБлоке Тогда

			Наименование = Блоки[0].Значения[0];

			// В блоке инв. номера бывает несколько написаний одного номера (3848 и 000003848).
			// Предпочитаем то, что стоит непосредственно под заголовком "ИНВ №".
			БлокИнв = Блоки[1];
			Если Шапка.КолонкаИнв >= БлокИнв.НачальнаяКолонка И Шапка.КолонкаИнв <= БлокИнв.КонечнаяКолонка Тогда
				ИнвентарныйНомер = ТекстЯчейки(ТабДок, НомерСтроки, Шапка.КолонкаИнв);
			КонецЕсли;
			Если ПустаяСтрока(ИнвентарныйНомер) Тогда
				ИнвентарныйНомер = БлокИнв.Значения[0];
			КонецЕсли;

		Иначе

			// Запасной вариант: блоки слиплись или не найдены - берем строго по колонкам шапки.
			Наименование = ТекстЯчейки(ТабДок, НомерСтроки, Шапка.КолонкаНаименование);
			Если ПустаяСтрока(Наименование) И Блоки.Количество() > 0 Тогда
				Наименование = Блоки[0].Значения[0];
			КонецЕсли;
			ИнвентарныйНомер = ТекстЯчейки(ТабДок, НомерСтроки, Шапка.КолонкаИнв);

		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НомерПП          = НомерПП;
		НоваяСтрока.Наименование     = НормализоватьНаименование(Наименование);
		НоваяСтрока.ИнвентарныйНомер = НормализоватьИнвНомер(ИнвентарныйНомер);
		НоваяСтрока.НомерСтрокиФайла = НомерСтроки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пример использования: разбор файла и сопоставление строк акта с ОС базы
// по инвентарному номеру (БП 3.0: регистр ПервоначальныеСведенияОСБухгалтерскийУчет).
//
// Параметры:
//   ИмяФайла    - Строка - путь к файлу акта.
//   Организация - СправочникСсылка.Организации.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица ПрочитатьДефектныйАкт() с доп. колонкой
//     * ОсновноеСредство - СправочникСсылка.ОсновныеСредства - найденное ОС или пустая ссылка.
//
Функция ПрочитатьДефектныйАктИНайтиОС(Знач ИмяФайла, Знач Организация) Экспорт

	ТаблицаАкта = ПрочитатьДефектныйАкт(ИмяФайла);
	ТаблицаАкта.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.ОсновноеСредство КАК ОсновноеСредство,
	|	Сведения.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(, Организация = &Организация) КАК Сведения
	|ГДЕ
	|	Сведения.ИнвентарныйНомер <> """"";
	Запрос.УстановитьПараметр("Организация", Организация);

	// Ключ - инв. номер без пробелов и ведущих нулей: в файле встречается "8" и "3848",
	// в базе такие номера обычно хранятся как "000000008" / "000003848".
	ОСПоИнвНомеру = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОСПоИнвНомеру.Вставить(КлючИнвНомера(Выборка.ИнвентарныйНомер), Выборка.ОсновноеСредство);
	КонецЦикла;

	Для Каждого СтрокаАкта Из ТаблицаАкта Цикл
		НайденноеОС = ОСПоИнвНомеру.Получить(КлючИнвНомера(СтрокаАкта.ИнвентарныйНомер));
		Если НайденноеОС <> Неопределено Тогда
			СтрокаАкта.ОсновноеСредство = НайденноеОС;
		КонецЕсли;
	КонецЦикла;

	Возврат ТаблицаАкта;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьФайлВТабличныйДокумент(Знач ИмяФайла)

	ТабДок = Новый ТабличныйДокумент;
	Попытка
		// Читаем типизированные значения (число/дата/строка), чтобы не зависеть от форматов ячеек Excel.
		ТабДок.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		// Старая платформа без второго параметра - читаем представления.
		ТабДок.Прочитать(ИмяФайла);
	КонецПопытки;

	Возврат ТабДок;

КонецФункции

// Ищет строку шапки таблицы: в одной строке должны быть ячейки "Наименование..." и "ИНВ...".
//
// Возвращаемое значение:
//   Структура - НомерСтроки, КолонкаПП, КолонкаНаименование, КолонкаИнв, КолонкаПричина (0 - не найдена);
//   Неопределено - шапка не найдена.
//
Функция НайтиШапкуТаблицы(ТабДок, ВысотаТаблицы, ШиринаТаблицы)

	Для НомерСтроки = 1 По ВысотаТаблицы Цикл

		КолонкаПП           = 0;
		КолонкаНаименование = 0;
		КолонкаИнв          = 0;
		КолонкаПричина      = 0;
		ПерваяНепустая      = 0;

		Для НомерКолонки = 1 По ШиринаТаблицы Цикл

			Текст = ВРег(ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки));
			Если ПустаяСтрока(Текст) Тогда
				Продолжить;
			КонецЕсли;
			Если ПерваяНепустая = 0 Тогда
				ПерваяНепустая = НомерКолонки;
			КонецЕсли;

			Если КолонкаПП = 0 И (Текст = "П/П" Или Текст = "№ П/П" Или Текст = "№П/П" Или Текст = "№") Тогда
				КолонкаПП = НомерКолонки;
			ИначеЕсли КолонкаНаименование = 0 И СтрНайти(Текст, "НАИМЕНОВАНИЕ") > 0 Тогда
				КолонкаНаименование = НомерКолонки;
			ИначеЕсли КолонкаИнв = 0 И СтрНайти(Текст, "ИНВ") > 0 Тогда
				КолонкаИнв = НомерКолонки;
			ИначеЕсли КолонкаПричина = 0 И СтрНайти(Текст, "ПРИЧИНА") > 0 Тогда
				КолонкаПричина = НомерКолонки;
			КонецЕсли;

		КонецЦикла;

		Если КолонкаНаименование > 0 И КолонкаИнв > 0 Тогда
			Если КолонкаПП = 0 Тогда
				КолонкаПП = ПерваяНепустая;
			КонецЕсли;
			Шапка = Новый Структура;
			Шапка.Вставить("НомерСтроки",         НомерСтроки);
			Шапка.Вставить("КолонкаПП",           КолонкаПП);
			Шапка.Вставить("КолонкаНаименование", КолонкаНаименование);
			Шапка.Вставить("КолонкаИнв",          КолонкаИнв);
			Шапка.Вставить("КолонкаПричина",      КолонкаПричина);
			Возврат Шапка;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Группирует непустые ячейки строки в блоки подряд идущих ячеек (разделитель - пустая ячейка).
//
// Возвращаемое значение:
//   Массив из Структура - НачальнаяКолонка, КонечнаяКолонка,
//     Значения (Массив из Строка - различные тексты блока в порядке следования, без повторов подряд).
//
Функция БлокиЗначенийСтроки(ТабДок, НомерСтроки, КолонкаС, КолонкаПо)

	Блоки = Новый Массив;
	ТекущийБлок = Неопределено;

	Для НомерКолонки = КолонкаС По КолонкаПо Цикл

		Текст = ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки);
		Если ПустаяСтрока(Текст) Тогда
			ТекущийБлок = Неопределено;
			Продолжить;
		КонецЕсли;

		Если ТекущийБлок = Неопределено Тогда
			ТекущийБлок = Новый Структура;
			ТекущийБлок.Вставить("НачальнаяКолонка", НомерКолонки);
			ТекущийБлок.Вставить("КонечнаяКолонка",  НомерКолонки);
			ТекущийБлок.Вставить("Значения",         Новый Массив);
			ТекущийБлок.Значения.Добавить(Текст);
			Блоки.Добавить(ТекущийБлок);
		Иначе
			ТекущийБлок.КонечнаяКолонка = НомерКолонки;
			Если ТекущийБлок.Значения[ТекущийБлок.Значения.ВГраница()] <> Текст Тогда
				ТекущийБлок.Значения.Добавить(Текст);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Блоки;

КонецФункции

// Текст ячейки без пробелов по краям. Числа - без разделителей групп, даты - dd.MM.yyyy.
Функция ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки)

	Область = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);

	Если Область.СодержитЗначение Тогда
		Значение = Область.Значение;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Формат(Значение, "ЧГ=0");
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
		ИначеЕсли Значение <> Неопределено Тогда
			Возврат СокрЛП(Строка(Значение));
		КонецЕсли;
	КонецЕсли;

	Возврат СокрЛП(Область.Текст);

КонецФункции

Функция ЧислоИзСтроки(Знач Текст)

	Текст = СтрЗаменить(СокрЛП(Текст), Символы.НПП, "");
	Текст = СтрЗаменить(Текст, " ", "");
	// Варианты нумерации "1." и "1)"
	Пока СтрДлина(Текст) > 0 И (Прав(Текст, 1) = "." Или Прав(Текст, 1) = ")") Цикл
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЦикла;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция НормализоватьИнвНомер(Знач Текст)

	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Текст = СтрЗаменить(Текст, Символы.ПС,  "");
	Текст = СтрЗаменить(Текст, Символы.ВК,  "");
	Текст = СтрЗаменить(Текст, " ", "");
	Возврат СокрЛП(Текст);

КонецФункции

Функция НормализоватьНаименование(Знач Текст)

	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Возврат СокрЛП(Текст);

КонецФункции

// Ключ для сопоставления инв. номеров файла и базы: верхний регистр, без пробелов и ведущих нулей.
Функция КлючИнвНомера(Знач Текст)

	Текст = ВРег(НормализоватьИнвНомер(Текст));
	Пока СтрДлина(Текст) > 1 И Лев(Текст, 1) = "0" Цикл
		Текст = Сред(Текст, 2);
	КонецЦикла;
	Возврат Текст;

КонецФункции

#КонецОбласти
